{
    "name": "C++",
    "build": {
        "dockerfile": "Containerfile"
    },
    "initializeCommand": "sh ${localWorkspaceFolder}/.devcontainer/opencode-extract-auth.sh ${localWorkspaceFolder}/.devcontainer/opencode-auth-seed.json",
    "remoteEnv": {
        "MILS_HOSTNAME": "soup"
    },
    "features": {
        "forgejo.mwasplund.com/mwasplund/devcontainers/mils:0": {
            "version": "0.1.225"
        },
        "forgejo.mwasplund.com/mwasplund/devcontainers/neovim:0": {
            "version": "0.12.5",
            "gitConfig": "https://github.com/mwasplund/config-nvim.git"
        },
        "forgejo.mwasplund.com/mwasplund/devcontainers/opencode:0": {
            "version": "2.1.4"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "10.0"
        }
    }
}
